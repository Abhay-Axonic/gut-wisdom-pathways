  "/faq": {
    "title": "Frequently asked questions | Microbiome Clinic",
    "description": "Answers about consultations, microbiome testing, fees and practical arrangements at our London gut health clinic.",
    "jsonLd": [
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Do I need a referral?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. You can request a consultation yourself."
            }
          },
          {
            "@type": "Question",
            "name": "What happens at the first appointment?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A specialist reviews your symptoms, history, medicines and previous investigations, then explains their view and the sensible next steps."
            }
          },
          {
            "@type": "Question",
            "name": "Where are appointments held?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Appointments are based in London. We confirm the arrangements when we contact you."
            }
          },
          {
            "@type": "Question",
            "name": "Will you share information with my GP?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Only with your permission. Keeping your GP informed usually helps your care stay joined up."
            }
          },
          {
            "@type": "Question",
            "name": "Can I buy a microbiome test from you?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Not at present. We focus on assessment and helping you decide whether a test is worthwhile."
            }
          },
          {
            "@type": "Question",
            "name": "Can a microbiome test diagnose my condition?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Microbiome tests cannot diagnose IBS, inflammatory bowel disease or cancer. Standard medical tests are needed for diagnosis."
            }
          },
          {
            "@type": "Question",
            "name": "Does sequencing measure inflammation?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Sequencing describes microbes. Inflammation markers such as faecal calprotectin are separate tests."
            }
          },
          {
            "@type": "Question",
            "name": "How much does a consultation cost?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Please request our current fees. We confirm the fee before anything is booked."
            }
          },
          {
            "@type": "Question",
            "name": "Will my insurer pay?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "We cannot guarantee insurance cover. Please check with your insurer before booking."
            }
          },
          {
            "@type": "Question",
            "name": "Do you sell supplements?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. We do not sell supplements or receive commission on products."
            }
          },
          {
            "@type": "Question",
            "name": "What if my symptoms are urgent?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Contact your GP or NHS 111. In an emergency, call 999."
            }
          }
        ]
      },
